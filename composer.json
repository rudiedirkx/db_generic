{
    "name": "rdx/db",
    "description": "Simple MySQL/SQLite wrapper",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rudie Dirkx",
            "email": "github@hotblocks.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "rdx\\db\\PhpStan\\": "src/phpstan/"
        },
        "classmap": ["src/"]
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
